{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild"
  },
  "contentMappers": [{ "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }],
  "include": [".astro/types.d.ts", "src", "astro.config.mjs"],
  "exclude": ["dist"]
}

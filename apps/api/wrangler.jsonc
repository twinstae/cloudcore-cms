{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudcore-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Better Auth가 AsyncLocalStorage를 쓴다.
  "compatibility_flags": ["nodejs_compat"],
  // 비밀값(BETTER_AUTH_SECRET)은 배포 때 `wrangler secret put`으로 넣는다.
  "vars": { "BETTER_AUTH_URL": "http://localhost:8787" },
  // Admin SPA 정적 자산을 같은 Worker가 서빙한다. /api/* 만 Worker 코드로 들어온다.
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // database_id는 인프라 프로비저닝 때 실제 값으로 바꾼다. 로컬(miniflare)은 아무 값이나 된다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudcore",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}

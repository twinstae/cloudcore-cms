{
  "name": "cloudcore",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "codegen": "bun run --filter '*' --if-present codegen",
    "dev": "bun run --filter '*' --parallel --if-present dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsrs -b --runExternalCode",
    "test": "bun run --filter '*' --if-present test:run",
    "check": "bun run codegen && bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  }
}
